# Fechô — Environment Variables (example, no real values)
# Copie para .env.local (web) e configure por ambiente (development/preview/production).
# Nunca commitar valores reais. Segredos nunca usam o prefixo NEXT_PUBLIC_.

# --- Database (server-side only) ---
DATABASE_URL="postgresql://user:password@localhost:5432/fecho_dev"
DIRECT_URL="postgresql://user:password@localhost:5432/fecho_dev"

# --- Auth ---
AUTH_SECRET="replace-with-strong-random-secret"
AUTH_TOKEN_TTL="15m"
AUTH_REFRESH_TOKEN_TTL="30d"

# --- OAuth (futuro) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# --- Email provider (Resend — docs/adr/ADR-023) ---
# Sem isso configurado, e-mails de verificação/reset de senha só aparecem
# no log do servidor (ConsoleEmailProvider) — ninguém recebe de verdade.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="no-reply@fecho.app"

# --- Rate limiting compartilhado (Upstash Redis — docs/adr/ADR-023) ---
# Sem isso configurado, o rate limiting usa um contador em memória por
# instância, que não funciona corretamente em produção serverless
# (Vercel) com múltiplas instâncias — ver docs/adr/ADR-011.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Push notifications ---
PUSH_PROVIDER_API_KEY=""

# --- Outbox / notificações (docs/adr/ADR-004, ADR-009) ---
# Segredo compartilhado para o worker/cron que drena a outbox via
# POST /api/v1/internal/process-outbox — nunca exposto ao cliente.
INTERNAL_JOB_SECRET="replace-with-strong-random-secret"

# --- Geolocation / Maps (futuro) ---
MAPS_PROVIDER_API_KEY=""

# --- Event discovery (futuro) ---
EVENT_DISCOVERY_PROVIDER_API_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
